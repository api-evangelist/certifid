{
  "opencollection": "1.0.0",
  "info": {
    "name": "CertifID V2 Underwriter API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.certifid.com/authorize?audience=https://api.certifid.com&connection=CertifID-Users-DB",
      "accessTokenUrl": "https://auth.certifid.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Underwriter",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves a list of underwriters associated to the location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/Account/:id/Underwriter",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the specific location to retrieve the title underwriters for."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://auth.certifid.com/authorize?audience=https://api.certifid.com&connection=CertifID-Users-DB",
              "accessTokenUrl": "https://auth.certifid.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves a list of underwriters associated to the location"
        }
      ]
    }
  ],
  "bundled": true
}