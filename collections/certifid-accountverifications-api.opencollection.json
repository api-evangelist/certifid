              }
            }
          },
          "docs": "Retrieve an account verification by id."
        },
        {
          "info": {
            "name": "Search account verifications for the authenticated tenant.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/AccountVerifications/Search",
            "body": {
              "type": "json",
              "data": "{}"
